# Use latest only for the first controlled test. Pin the validated tag or digest
# before exposing the service outside the VPS.
NINE_ROUTER_IMAGE=decolua/9router:latest
NINE_ROUTER_PUBLIC_URL=https://ai.example.com
NPM_NETWORK_NAME=npm-proxy

JWT_SECRET=replace-with-a-long-random-secret
INITIAL_PASSWORD=replace-with-a-strong-initial-password
API_KEY_SECRET=replace-with-another-long-random-secret
MACHINE_ID_SALT=replace-with-an-independent-random-salt
