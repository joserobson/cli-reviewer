{
  "name": "mr-reviewer",
  "version": "1.0.0",
  "description": "CLI para análise de Merge Requests do GitLab usando Codex, Gemini ou Claude Code local",
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/doctor.ts",
    "review": "tsx src/index.ts",
    "watch": "tsx src/watcher.ts",
    "webhook": "tsx src/webhook-server.ts",
    "dashboard": "tsx src/dashboard.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
