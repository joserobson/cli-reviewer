# ─── GitLab ────────────────────────────────────────────────────────────────────

# GitLab instance URL (no trailing slash)
GITLAB_URL=https://your-gitlab.example.com

# Personal Access Token — GitLab > Profile > Access Tokens > scope: api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ─── GitHub ────────────────────────────────────────────────────────────────────

# Optional for reading public Pull Requests; required to comment, approve or merge.
# Fine-grained token permissions: Pull requests read/write, Contents read.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_API_URL=https://api.github.com

# Optional secret for /webhooks/github signature validation. If omitted, WEBHOOK_SECRET is used.
GITHUB_WEBHOOK_SECRET=change-me

# ─── Projects ──────────────────────────────────────────────────────────────────
# Format: id:type:label  (comma-separated, supports any number of projects)
# Types: front (Angular), api (.NET C#), generic (any language)
#
# GitLab examples:
#   GITLAB_PROJECTS=133:front:Frontend Angular
#   GITLAB_PROJECTS=133:front:Frontend,134:api:API .NET
#   GITLAB_PROJECTS=133:front:Web,134:api:Backend,135:generic:Mobile BFF
GITLAB_PROJECTS=133:front:Frontend Angular,134:api:API .NET

# GitHub examples:
#   GITHUB_REPOSITORIES=owner/repo:generic:CLI Reviewer
#   GITHUB_REPOSITORIES=owner/web:front:Web,owner/api:api:API
GITHUB_REPOSITORIES=

# ─── AI CLI Providers ──────────────────────────────────────────────────────────
# Enable one or more local AI CLIs. Defaults: Codex/Gemini on, Claude Code off.
CODEX_ENABLED=true
GEMINI_ENABLED=true
CODE_ENABLED=false

# Customize command names or arguments only when your local setup differs.
# CODEX_CMD=codex
# CODEX_ARGS=exec -
# GEMINI_CMD=gemini
# GEMINI_ARGS=--yolo
# CODE_CMD=claude
# CODE_ARGS=--print

# ─── Automatic review (npm run watch / npm run webhook) ───────────────────────

# Manual/interactive use can keep automation disabled. npm run watch and
# npm run webhook still use the safety switches below.
AUTO_REVIEW_ENABLED=false
AUTO_REVIEW_MODE=polling
AUTO_REVIEW_POST_COMMENT=true
AUTO_REVIEW_NOTIFY_DESKTOP=true
AUTO_REVIEW_SKIP_DRAFT=true
AUTO_REVIEW_APPROVE_ON_SUCCESS=false
AUTO_REVIEW_MERGE_ON_SUCCESS=false

# Polling interval in minutes (default: 2)
WATCH_INTERVAL_MINUTES=2

# Local metrics dashboard
DASHBOARD_PORT=3334

# Webhook server settings (used when AUTO_REVIEW_MODE=webhook)
WEBHOOK_PORT=3333
WEBHOOK_SECRET=change-me

# Optional when GitLab webhooks are forwarded by Agent Hub. The task id arrives
# in X-AgentHub-Review-Task-Id and results are authenticated with this secret.
AGENT_HUB_CALLBACK_URL=http://agent-hub-api:8080/api/webhooks/reviews
AGENT_HUB_CALLBACK_SECRET=change-me-too

# Estimated monthly token limits per LLM (0 = no limit / unlimited)
# The tool estimates tokens as: characters / 4
# When one provider is exhausted, the other is used automatically.
#
# Reference values vary by provider and account plan. Keep 0 for no local limit.
WATCH_CODEX_MONTHLY_TOKENS=0
WATCH_GEMINI_MONTHLY_TOKENS=0
WATCH_CODE_MONTHLY_TOKENS=0

# ─── Timezone ──────────────────────────────────────────────────────────────────
# Timezone for logs and dashboard (IANA timezone format)
# Default: America/Sao_Paulo
# Examples: America/New_York, Europe/London, Asia/Tokyo
# TZ=America/Sao_Paulo
