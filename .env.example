# GitLab instance URL (no trailing slash)
GITLAB_URL=https://your-gitlab.example.com

# Personal Access Token — GitLab > Profile > Access Tokens > scope: api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ─── Projects ──────────────────────────────────────────────────────────────────
# Format: id:type:label  (comma-separated, supports any number of projects)
# Types: front (Angular), api (.NET C#), generic (any language)
#
# Examples:
#   GITLAB_PROJECTS=133:front:Frontend Angular
#   GITLAB_PROJECTS=133:front:Frontend,134:api:API .NET
#   GITLAB_PROJECTS=133:front:Web,134:api:Backend,135:generic:Mobile BFF
GITLAB_PROJECTS=133:front:Frontend Angular,134:api:API .NET

# ─── AI CLI Commands ───────────────────────────────────────────────────────────
# Customize if your CLI uses different flags or is installed under a different name.
# Defaults shown below — only set these if you need to override.
#
# CLAUDE_CMD=claude
# CLAUDE_ARGS=--print
# GEMINI_CMD=gemini
# GEMINI_ARGS=--yolo

# ─── Watcher (npm run watch) ───────────────────────────────────────────────────

# Polling interval in minutes (default: 2)
WATCH_INTERVAL_MINUTES=2

# Estimated monthly token limits per LLM (0 = no limit / unlimited)
# The tool estimates tokens as: characters / 4
# When one provider is exhausted, the other is used automatically.
#
# Reference (approximate, check your plan):
#   Claude Pro: ~7,000,000 tokens/month
#   Gemini free tier: varies by region and plan
WATCH_CLAUDE_MONTHLY_TOKENS=0
WATCH_GEMINI_MONTHLY_TOKENS=0
